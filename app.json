{
  "expo": {
    "name": "ArtInfo",
    "slug": "artinfo-app",
    "version": "1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "artinfo",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.artinfokorea.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "게시글, 공고, 프로필 이미지를 올리기 위해 사진 보관함에 접근합니다.",
        "NSCameraUsageDescription": "프로필 이미지를 촬영하기 위해 카메라에 접근합니다.",
        "CFBundleDisplayName": "아트인포",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.artinfokorea.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#0064FF"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "게시글, 공고, 프로필 이미지를 올리기 위해 사진 보관함에 접근합니다.",
          "cameraPermission": "프로필 이미지를 촬영하기 위해 카메라에 접근합니다.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ed5a5cc7-75c4-41d8-8783-bc77ce894b8e"
      }
    },
    "owner": "ddoniel"
  }
}
